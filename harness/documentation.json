    {
      "id": "hashed_source_url",
      "pattern": "(?i)https?://(?:www\\.)?github\\.com/[^/\\s]+/[^/\\s]+/(?:blob|tree)/[0-9a-f]{40}(?:/|\\b)"
    },
    {
      "id": "explicit_source_identifier",
      "pattern": "(?i)\\b(?:commit(?:\\s+(?:id|hash))?|revision)\\s*[:=@]?\\s*[`\"']?[0-9a-f]{7,40}\\b"
    }
