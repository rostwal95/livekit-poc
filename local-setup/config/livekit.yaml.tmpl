port: 7880
bind_addresses:
  - "0.0.0.0"
rtc:
  tcp_port: {tcp_port}
  udp_port: {udp_port}
  node_ip: "{node_ip}"
  use_external_ip: false
  advertise_internal_ip: true
  enable_loopback_candidate: true
room:
  auto_create: true
  empty_timeout: 60
  departure_timeout: 20
  max_participants: 8
logging:
  level: info
  json: true
prometheus_port: 9780
