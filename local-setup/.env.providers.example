# Credentials for the optional provider_real voice profile (P1 conversation agent).
#
# Setup: run `make provider-setup` (creates local-setup/.env.providers with mode
# 0600 if it is missing), then paste your values there and run
# `make provider-check`. The check prints presence booleans only and makes no
# provider call. Never commit, source or print the filled file.
#
# Values are literal (no quotes needed, no shell expansion), 16-512 printable
# characters. Exactly these three names are accepted; any other name fails closed.

# Speech-to-text: Deepgram nova-3, batch recognition after a manual turn flush.
DEEPGRAM_API_KEY=

# Language model: OpenAI gpt-5.4-mini, streaming chat completions.
OPENAI_API_KEY=

# Text-to-speech: ElevenLabs eleven_v4_turbo.
ELEVEN_API_KEY=
