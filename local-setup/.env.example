# Non-secret localhost defaults. Copy with stack.py init.
BIND_ADDRESS=127.0.0.1
UI_PORT=13000
API_PORT=18080
LIVEKIT_HTTP_PORT=17880
LIVEKIT_TCP_PORT=17881
LIVEKIT_UDP_PORT=17882
POSTGRES_PORT=15432
JAEGER_UI_PORT=26686
LIVEKIT_NODE_IP=127.0.0.1

# Optional distinct compose project (containers, volumes, images) so another
# checkout can run beside this one. Use distinct ports as well when both run.
# STACK_PROJECT=livekit-agent-ecosystem

# Optional worker profile; requires explicitly prepared ACTIVE PostgreSQL v4.
P1_WORKER_SCOPE=demo-traveller
P1_WORKER_SCHEMA=continuity
